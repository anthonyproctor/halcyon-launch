#!/usr/bin/env python3
# Fake macOS `security` for tests/r2_sync.spec.mjs: find-generic-password -a halcyon -s <service> -w, answered from $FAKE_KEYCHAIN (a JSON file).
import json, os, sys
a = sys.argv[1:]
try: kc = json.load(open(os.environ["FAKE_KEYCHAIN"]))
except Exception: kc = {}
if a[:1] != ["find-generic-password"] or "-s" not in a or a[a.index("-a") + 1] != "halcyon": sys.exit(44)
v = kc.get(a[a.index("-s") + 1])
if v is None:
    print("security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.", file=sys.stderr); sys.exit(44)
print(v)
